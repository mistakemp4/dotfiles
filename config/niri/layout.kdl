layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    // colors overridden by glow.kdl
    shadow {
        on
        softness 8
        spread 4
        offset x=0 y=0
        color          "#ec5f68ff"
        inactive-color "#ec5f6826"
    }

    background-color   "#00000000"
}
