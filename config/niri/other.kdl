screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d-%H-%M-%S.png"

prefer-no-csd

environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    // for apps that load cursors themselves; niri uses cursor.kdl
    XCURSOR_THEME "Noctalia-Cursors"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

switch-events {
    lid-close {
        spawn "noctalia" "msg" "session" "lock-and-suspend";
    }
}

overview {
    workspace-shadow {
        softness 40
        spread   10
        offset   x=0 y=10
        color "#00000050"
    }
}

workspace "1"
workspace "2"

debug {
    // vesktop focus stealing via stale notification activation serials
    honor-xdg-activation-with-invalid-serial
}

animations {
    overview-open-close {
        spring damping-ratio=0.8 stiffness=800 epsilon=0.0001
    }
}
