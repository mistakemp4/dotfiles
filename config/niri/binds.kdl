binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+T hotkey-overlay-title="Open a Terminal: alacritty"  { spawn    "alacritty"; }
    Mod+D hotkey-overlay-title="Run an Application"        { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B hotkey-overlay-title="Open a web browser: brave" { spawn-sh "brave --load-extension=$HOME/.local/share/noctalia/brave-theme,$HOME/src/darkreader-noctalia/build/release/chrome-mv3"; }
    Mod+S hotkey-overlay-title="Open Spotify"               { spawn    "spotify"; }

    Ctrl+Alt+Q hotkey-overlay-title="Lock the Screen"          { spawn-sh "loginctl lock-session"; }
    Ctrl+Alt+E hotkey-overlay-title="Open power menu"          { spawn-sh "noctalia msg panel-toggle session"; }
    Ctrl+Alt+S hotkey-overlay-title="Toggle Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Ctrl+Alt+C hotkey-overlay-title="Enlarge cursor" {
        spawn-sh "niri msg action load-config-file --path ~/.config/niri/large-cursor.kdl"
    }

    Mod+Space hotkey-overlay-title="Toggle Noctalia shell control-center" { spawn-sh "noctalia msg panel-toggle control-center home"; }

    Mod+E hotkey-overlay-title="Open file manager: thunar" { spawn "thunar"; }
    Mod+N hotkey-overlay-title="Toggle notification center" {
        spawn-sh "noctalia msg panel-toggle control-center notifications";
    }
    Mod+Shift+N hotkey-overlay-title="Clear notification history" {
        spawn-sh "noctalia msg notification-clear-history";
    }
    Mod+Alt+N hotkey-overlay-title="Toggle Do Not Disturb" {
        spawn-sh "noctalia msg notification-dnd-toggle";
    }

    // keychron knob
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    Shift+XF86AudioMute  allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    Mod+O hotkey-overlay-title="Toggle overview" repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+H     { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+L     { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+K     { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+J     { move-window-down; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }

    Mod+WheelScrollDown       { focus-window-or-workspace-down; }
    Mod+Shift+WheelScrollDown { focus-column-or-monitor-right; }
    Mod+Shift+WheelScrollUp   { focus-column-or-monitor-left; }
    Mod+WheelScrollUp         { focus-window-or-workspace-up; }

    Mod+Ctrl+WheelScrollDown       { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp         { move-column-to-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right-or-to-monitor-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left-or-to-monitor-left; }

    Mod+1       hotkey-overlay-title=null { focus-workspace 1; }
    Mod+2       hotkey-overlay-title=null { focus-workspace 2; }
    Mod+3       hotkey-overlay-title=null { focus-workspace 3; }
    Mod+4       hotkey-overlay-title=null { focus-workspace 4; }
    Mod+5       hotkey-overlay-title=null { focus-workspace 5; }
    Mod+6       hotkey-overlay-title=null { focus-workspace 6; }
    Mod+7       hotkey-overlay-title=null { focus-workspace 7; }
    Mod+8       hotkey-overlay-title=null { focus-workspace 8; }
    Mod+9       hotkey-overlay-title=null { focus-workspace 9; }

    Mod+Shift+1 hotkey-overlay-title=null { move-column-to-workspace 1; }
    Mod+Shift+2 hotkey-overlay-title=null { move-column-to-workspace 2; }
    Mod+Shift+3 hotkey-overlay-title=null { move-column-to-workspace 3; }
    Mod+Shift+4 hotkey-overlay-title=null { move-column-to-workspace 4; }
    Mod+Shift+5 hotkey-overlay-title=null { move-column-to-workspace 5; }
    Mod+Shift+6 hotkey-overlay-title=null { move-column-to-workspace 6; }
    Mod+Shift+7 hotkey-overlay-title=null { move-column-to-workspace 7; }
    Mod+Shift+8 hotkey-overlay-title=null { move-column-to-workspace 8; }
    Mod+Shift+9 hotkey-overlay-title=null { move-column-to-workspace 9; }

    Mod+Ctrl+1  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 1 --focus false"; }
    Mod+Ctrl+2  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 2 --focus false"; }
    Mod+Ctrl+3  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 3 --focus false"; }
    Mod+Ctrl+4  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 4 --focus false"; }
    Mod+Ctrl+5  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 5 --focus false"; }
    Mod+Ctrl+6  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 6 --focus false"; }
    Mod+Ctrl+7  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 7 --focus false"; }
    Mod+Ctrl+8  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 8 --focus false"; }
    Mod+Ctrl+9  hotkey-overlay-title=null { spawn-sh "niri msg action move-column-to-workspace 9 --focus false"; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R       repeat=false { switch-preset-column-width; }
    Mod+Shift+R repeat=false { switch-preset-window-height; }
    Mod+Ctrl+R  repeat=false { reset-window-height; }
    Mod+F       repeat=false { maximize-column; }
    Mod+Shift+F repeat=false { fullscreen-window; }

    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+Minus hotkey-overlay-title="Decrease window width by 10%" { set-column-width "-10%"; }
    Mod+Equal hotkey-overlay-title="Increase window width by 10%" { set-column-width "+10%"; }
    Mod+0     hotkey-overlay-title="Restore window width to 50%"  { set-column-width "50%"; }

    Mod+Shift+Minus hotkey-overlay-title="Decrease window height by 10%" { set-window-height "-10%"; }
    Mod+Shift+Equal hotkey-overlay-title="Increase window height by 10%" { set-window-height "+10%"; }
    Mod+Shift+0     hotkey-overlay-title="Restore window height to 50%"  { set-window-height "100%"; }

    Mod+V       { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V { toggle-window-floating; }

    Mod+W hotkey-overlay-title="Toggle column tabbed display" { toggle-column-tabbed-display; }

    Ctrl+Shift+Page_Up   hotkey-overlay-title="Screenshot: selection" { screenshot; }
    Ctrl+Shift+Page_Down hotkey-overlay-title="Screenshot: screen"    { screenshot-screen; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Ctrl+Alt+Delete hotkey-overlay-title="Quit niri" { quit; }

    Ctrl+Shift+Escape { spawn-sh "alacritty -e btop"; }

    Mod+Shift+P hotkey-overlay-title="Power off monitors" { power-off-monitors; }

    Mod+C hotkey-overlay-title="Pick an entry from clipboard history" {
        spawn-sh "noctalia msg panel-toggle clipboard";
    }

    Mod+Alt+C hotkey-overlay-title="Clear all entries from clipboard history" {
        spawn-sh "noctalia msg clipboard-clear";
    }
}
