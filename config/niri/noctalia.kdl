layout {

    focus-ring {
        active-color   "#f3585b"
        inactive-color "#291414"
        urgent-color   "#9a0b0d"
    }

    border {
        active-color   "#f3585b"
        inactive-color "#291414"
        urgent-color   "#9a0b0d"
    }


    tab-indicator {
        active-color   "#f3585b"
        inactive-color "#90090b"
        urgent-color   "#9a0b0d"
    }

    insert-hint {
        color "#f3585b80"
    }
}

recent-windows {
    highlight {
        active-color "#f3585b"
        urgent-color "#9a0b0d"
    }
}
