layout {

    focus-ring {
        active-color   "#82e3e9"
        inactive-color "#0c2931"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#82e3e9"
        inactive-color "#0c2931"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#82e3e9"
        inactive-color "#1799a1"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#82e3e980"
    }
}

recent-windows {
    highlight {
        active-color "#82e3e9"
        urgent-color "#fd4663"
    }
}
