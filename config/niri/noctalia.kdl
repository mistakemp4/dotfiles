layout {

    focus-ring {
        active-color   "#ff4d4e"
        inactive-color "#291414"
        urgent-color   "#a10001"
    }

    border {
        active-color   "#ff4d4e"
        inactive-color "#291414"
        urgent-color   "#a10001"
    }


    tab-indicator {
        active-color   "#ff4d4e"
        inactive-color "#9a0001"
        urgent-color   "#a10001"
    }

    insert-hint {
        color "#ff4d4e80"
    }
}

recent-windows {
    highlight {
        active-color "#ff4d4e"
        urgent-color "#a10001"
    }
}
