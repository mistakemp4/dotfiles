layout {

    focus-ring {
        active-color   "#e467a4"
        inactive-color "#29141e"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e467a4"
        inactive-color "#29141e"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e467a4"
        inactive-color "#85144b"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e467a480"
    }
}

recent-windows {
    highlight {
        active-color "#e467a4"
        urgent-color "#fd4663"
    }
}
