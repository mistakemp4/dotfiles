layout {

    focus-ring {
        active-color   "#67e46f"
        inactive-color "#1a231b"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67e46f"
        inactive-color "#1a231b"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67e46f"
        inactive-color "#14851b"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67e46f80"
    }
}

recent-windows {
    highlight {
        active-color "#67e46f"
        urgent-color "#fd4663"
    }
}
