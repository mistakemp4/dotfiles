layout {

    focus-ring {
        active-color   "#e567a7"
        inactive-color "#29141f"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e567a7"
        inactive-color "#29141f"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e567a7"
        inactive-color "#86134e"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e567a780"
    }
}

recent-windows {
    highlight {
        active-color "#e567a7"
        urgent-color "#fd4663"
    }
}
