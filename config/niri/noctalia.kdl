layout {

    focus-ring {
        active-color   "#ec6061"
        inactive-color "#291414"
        urgent-color   "#bd1718"
    }

    border {
        active-color   "#ec6061"
        inactive-color "#291414"
        urgent-color   "#bd1718"
    }


    tab-indicator {
        active-color   "#ec6061"
        inactive-color "#8c0e0f"
        urgent-color   "#bd1718"
    }

    insert-hint {
        color "#ec606180"
    }
}

recent-windows {
    highlight {
        active-color "#ec6061"
        urgent-color "#bd1718"
    }
}
