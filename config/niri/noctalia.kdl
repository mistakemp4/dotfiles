layout {

    focus-ring {
        active-color   "#2bb897"
        inactive-color "#0a0e0d"
        urgent-color   "#ff6b72"
    }

    border {
        active-color   "#2bb897"
        inactive-color "#0a0e0d"
        urgent-color   "#ff6b72"
    }


    tab-indicator {
        active-color   "#2bb897"
        inactive-color "#0c4034"
        urgent-color   "#ff6b72"
    }

    insert-hint {
        color "#2bb89780"
    }
}

recent-windows {
    highlight {
        active-color "#2bb897"
        urgent-color "#ff6b72"
    }
}
