+// Noctalia: palette from local-bin/darkreader-colors-server.py
+const PALETTE_URL = 'http://127.0.0.1:6767/';
+const PALETTE_ALARM = 'noctalia-palette';
+const HEX_COLOR = /^#[0-9a-f]{6}$/i;
+
+async function syncPalette() {
+    let colors: {backgroundColor?: unknown; textColor?: unknown};
+    try {
+        const response = await fetch(PALETTE_URL, {cache: 'no-store'});
+        if (!response.ok) {
+            return;
+        }
+        colors = await response.json();
+    } catch {
+        return;
+    }
+    const {backgroundColor, textColor} = colors;
+    if (typeof backgroundColor !== 'string' || typeof textColor !== 'string' ||
+        !HEX_COLOR.test(backgroundColor) || !HEX_COLOR.test(textColor)) {
+        return;
+    }
+    await extension;
+    const {settings} = await Extension.collectData();
+    const colorsMatch = settings.theme.darkSchemeBackgroundColor === backgroundColor &&
+        settings.theme.darkSchemeTextColor === textColor;
+    if (colorsMatch && !settings.detectDarkTheme) {
+        return;
+    }
+    await Extension.changeSettings({
+        detectDarkTheme: false,
+        theme: {...settings.theme, darkSchemeBackgroundColor: backgroundColor, darkSchemeTextColor: textColor},
+    });
+}
+
+// wakes the suspended MV3 worker
+chrome.alarms.create(PALETTE_ALARM, {periodInMinutes: 0.5});
+chrome.alarms.onAlarm.addListener((alarm) => {
+    if (alarm.name === PALETTE_ALARM) {
+        syncPalette();
+    }
+});
+setInterval(syncPalette, 2000);
+syncPalette();
