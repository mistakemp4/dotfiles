#!/usr/bin/env python3
import os
import re
import subprocess
import sys
import time

CFG = os.path.expanduser("~/.config/niri")
LIB = os.path.join(CFG, "shaders")
OUT = os.path.join(CFG, "shaders.kdl")
STATE = os.path.join(LIB, ".active")
SLOTS = ("open", "close", "resize")


def available(slot):
    return sorted(
        f[len(slot) + 1:-5]
        for f in os.listdir(LIB)
        if f.startswith(slot + "-") and f.endswith(".frag")
    )


def uses_spring(slot, name):
    first = open(os.path.join(LIB, f"{slot}-{name}.frag")).readline()
    return first.startswith("// @anim") and "spring" in first


def blurb(slot, name):
    for line in open(os.path.join(LIB, f"{slot}-{name}.frag")):
        if line.startswith("// @anim"):
            continue
        if line.startswith("//"):
            text = line[2:].strip()
            return text[len(name) + 1:].strip() if text.startswith(name + ":") else text
    return ""


def split_entry(v):
    if v and ":" in v:
        name, ms = v.rsplit(":", 1)
        if ms.isdigit():
            return name, int(ms)
    return v, None


def load_state():
    state = {}
    if os.path.exists(STATE):
        for line in open(STATE):
            if "=" in line:
                k, v = line.strip().split("=", 1)
                state[k] = v
    return state


def save_state(state):
    with open(STATE, "w") as f:
        for k in SLOTS:
            if state.get(k):
                f.write(f"{k}={state[k]}\n")


def render(state):
    out = ["// generated by niri-shader — edit shaders/*.frag instead\n",
           "animations {\n"]
    for slot in SLOTS:
        name, override = split_entry(state.get(slot))
        if not name:
            continue
        path = os.path.join(LIB, f"{slot}-{name}.frag")
        if not os.path.exists(path):
            print(f"warning: {slot}-{name}.frag is gone, dropping it", file=sys.stderr)
            state.pop(slot, None)
            continue
        src = open(path).read()
        settings = ""
        m = re.match(r"//\s*@anim\s+(.*)", src.splitlines()[0])
        if m:
            settings = m.group(1)
            src = "\n".join(src.splitlines()[1:])
        if override is not None:
            if "spring" not in settings:
                settings = re.sub(r"duration-ms\s+\d+", f"duration-ms {override}", settings)
        if '"#' in src:
            sys.exit(f"{slot}-{name}.frag contains '\"#', which closes the KDL raw string")
        body = "\n".join("            " + l if l.strip() else "" for l in src.strip().splitlines())
        out.append(f"    window-{slot} {{\n")
        if settings:
            out.append(f"        {settings}\n")
        out.append(f'        custom-shader r#"\n{body}\n        "#\n')
        out.append("    }\n")
    out.append("}\n")
    return "".join(out)


def apply(state, persist=True):
    text = render(state)
    prev = open(OUT).read() if os.path.exists(OUT) else None
    with open(OUT, "w") as f:
        f.write(text)
    r = subprocess.run(["niri", "validate"], capture_output=True, text=True)
    if r.returncode != 0:
        if prev is not None:
            with open(OUT, "w") as f:
                f.write(prev)
        sys.exit("config rejected, reverted:\n" + (r.stderr or r.stdout))
    if persist:
        save_state(state)


def demo(slot, name, hold=2.4):
    saved = load_state()
    trial = dict(saved)
    trial[slot] = name
    apply(trial, persist=False)
    time.sleep(0.4)

    label = f"{name}\n\n  {blurb(slot, name)}"
    script = (
        "printf '\\n\\n  \\033[1;35m%s\\033[0m\\n' \"$1\"; "
        f"sleep {hold}"
    )
    p = subprocess.Popen(
        ["alacritty", "--title", f"shader demo: {name}", "-e", "sh", "-c", script, "_", label],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    p.wait()
    time.sleep(1.0)
    apply(saved, persist=False)


def usage():
    print("swap niri window shaders (GLSL is inlined into shaders.kdl)\n")
    print("usage:")
    print("  niri-shader list                      what's installed, * = active")
    print("  niri-shader status                    what's active right now")
    print("  niri-shader demo <slot> <name>        preview one, then revert")
    print("  niri-shader tour [slot]               preview every one in turn")
    print("  niri-shader <slot> <name|off> [ms]    set it for real, optional duration")
    print()
    for slot in SLOTS:
        print(f"  {slot}:", ", ".join(available(slot)))
    sys.exit(1)


def main():
    args = sys.argv[1:]
    state = load_state()

    if not args or args[0] in ("-h", "--help", "help"):
        usage()

    if args[0] == "list":
        for slot in SLOTS:
            for n in available(slot):
                active, _ = split_entry(state.get(slot))
                mark = "*" if active == n else " "
                print(f" {mark} {slot:6} {n:18} {blurb(slot, n)[:70]}")
        return

    if args[0] == "status":
        for slot in SLOTS:
            name, ms = split_entry(state.get(slot))
            extra = f"  ({ms}ms)" if ms else ""
            print(f"{slot:6} {name or '(niri default)'}{extra}")
        return

    if args[0] == "demo":
        if len(args) != 3 or args[1] not in SLOTS:
            usage()
        if args[2] not in available(args[1]):
            sys.exit(f"no {args[1]} shader '{args[2]}'")
        print(f"demoing {args[1]}/{args[2]} — watch the window open and close")
        demo(args[1], args[2])
        print("reverted to:", state.get(args[1]) or "(niri default)")
        return

    if args[0] == "tour":
        slots = [args[1]] if len(args) == 2 and args[1] in SLOTS else ["open", "close"]
        for slot in slots:
            for n in available(slot):
                print(f"  {slot:6} {n:18} {blurb(slot, n)[:60]}")
                demo(slot, n)
                time.sleep(0.6)
        print("tour done, nothing changed. set one with: niri-shader <slot> <name>")
        return

    slot = args[0]
    if slot not in SLOTS or len(args) not in (2, 3):
        usage()
    name = args[1]
    ms = None
    if len(args) == 3:
        if not args[2].isdigit():
            sys.exit(f"duration must be a whole number of milliseconds, got '{args[2]}'")
        ms = int(args[2])

    if name == "off":
        state.pop(slot, None)
    elif name in available(slot):
        if ms and uses_spring(slot, name):
            print(f"note: {slot}-{name} uses a spring curve, not a duration — "
                  f"ignoring {ms}ms (edit stiffness in the .frag instead)",
                  file=sys.stderr)
            ms = None
        state[slot] = f"{name}:{ms}" if ms else name
    else:
        sys.exit(f"no {slot} shader '{name}'. have: {', '.join(available(slot))}")

    apply(state)
    shown, dur = split_entry(state.get(slot))
    print(f"{slot} -> {shown or '(niri default)'}" + (f" at {dur}ms" if dur else ""))


main()
