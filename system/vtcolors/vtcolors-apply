import re
import subprocess
import sys
from pathlib import Path

HEX = re.compile(r"^#[0-9a-fA-F]{6}$")
DEFAULT_SRC = Path("/home/seal/.cache/noctalia/vtrgb")
STAGED = Path("/run/vtrgb")
CONSOLE = "/dev/tty0"

def brighten(color, factor=1.4):
    r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(min(255, round(c * factor)) for c in (r, g, b))

def main():
    args = [a for a in sys.argv[1:] if a != "--dry-run"]
    dry = "--dry-run" in sys.argv[1:]
    src = Path(args[0]) if args else DEFAULT_SRC

    lines = [l.strip() for l in src.read_text().splitlines() if l.strip()]
    if len(lines) != 16 or not all(HEX.match(l) for l in lines):
        sys.exit(f"{src}: expected 16 lines of #rrggbb, refusing to apply")

    palette = list(lines)
    for i in range(9, 15):
        if palette[i].lower() == palette[i - 8].lower():
            palette[i] = brighten(palette[i])

    text = "\n".join(palette) + "\n"
    if dry:
        sys.stdout.write(text)
        return
    STAGED.write_text(text)
    subprocess.run(["setvtrgb", "-C", CONSOLE, str(STAGED)], check=True)

if __name__ == "__main__":
    main()
