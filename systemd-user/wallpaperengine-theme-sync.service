[Unit]
Description=Sync Noctalia's wallpaper-adaptive theme when Wallpaper Engine's wallpaper changes
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/wallpaperengine-theme-sync.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
