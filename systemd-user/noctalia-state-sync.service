[Unit]
Description=Copy Noctalia's GUI-saved settings into the dotfiles repo
StartLimitIntervalSec=0

# public repo: drop location lines
[Service]
Type=oneshot
ExecStart=/bin/sh -c "sed -E '/^[[:space:]]*(address|latitude|longitude)[[:space:]]*=/d' %h/.local/state/noctalia/settings.toml > %h/src/dotfiles/config/noctalia/state-settings.toml"
