[Unit]
Description=Report theme templates and post-hooks that didn't land
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 25
ExecStart=%h/.local/bin/theme-healthcheck.py --notify
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
